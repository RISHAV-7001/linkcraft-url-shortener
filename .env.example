# Copy this file to .env and change values as needed.
NODE_ENV=development
PORT=3000

# Required for public custom short links when deploying outside Render.
# On Render, this app automatically uses RENDER_EXTERNAL_URL in production.
# Do NOT set this to localhost or a LAN IP. Example custom domain: BASE_URL=https://linkcraft.example.com
BASE_URL=

# LAN_IP is intentionally not used to create share links: LAN URLs do not work from other networks.

# Add a Google Safe Browsing API key to enable server-side URL threat checks.
# Without a key, the site warns that links have NOT been scanned; it does not call them safe.
SAFE_BROWSING_API_KEY=

# Optional persistent data directory. Defaults to ./data. On Render Blueprint, this is set to /var/data.
# DATA_DIR=./data
